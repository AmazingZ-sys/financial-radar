# Copy to deploy.env (untracked) and source only trusted local configuration.
DEPLOY_ROOT=/opt/financial-radar
COMPOSE_FILE=docker-compose.yml
APP_ENV_FILE=.env
BACKUP_DIR=/var/backups/financial-radar
HEALTH_URL=http://127.0.0.1:13000/ready
GITHUB_REPOSITORY=AmazingZ-sys/financial-radar
NGINX_RELOAD=true
# The application .env must use container hostnames postgres/redis and percent-encoded URL credentials.
# APP_VERSION/API_IMAGE/WORKER_IMAGE/X_COLLECTOR_IMAGE are persisted under .deploy; do not override here.
# Missing X_COLLECTOR_SECRET is generated in .deploy/x-collector.secret (0600).
# Collector uses only Docker internal :8080; no host port (including 8888) is needed.
# GHCR credentials are optional if images are public or docker login already exists.
GHCR_USER=
GHCR_TOKEN=
# Optional read-only repository token for private GitHub Release metadata/assets.
GITHUB_TOKEN=
