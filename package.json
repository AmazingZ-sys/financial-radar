{
  "name": "financial-radar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @radar/web dev",
    "dev:api": "pnpm --filter @radar/api dev",
    "dev:worker": "pnpm --filter @radar/worker dev",
    "build": "turbo run build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @radar/database migrate",
    "services:local": "tsx scripts/local-services.ts",
    "security:check": "tsx scripts/security-check.ts",
    "api:types": "tsx scripts/generate-api.ts",
    "release": "semantic-release",
    "admin:reset": "pnpm --filter @radar/api exec tsx src/admin.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^24.10.1",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.8.1",
    "redis-memory-server": "^0.17.1",
    "semantic-release": "^25.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.2.0",
    "vercel": "65.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/darwin-arm64",
      "redis-memory-server"
    ]
  },
  "redisMemoryServer": {
    "version": "7.4.2",
    "disablePostinstall": true
  }
}
