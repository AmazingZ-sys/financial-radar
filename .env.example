# Copy to .env for local development. These placeholders must be replaced in production.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATA_MODE=fixture
DATABASE_URL=postgresql://radar:radar_dev_only@127.0.0.1:5432/radar
REDIS_URL=redis://127.0.0.1:6379
ADMIN_EMAIL=admin@radar.local
ADMIN_PASSWORD=change-me-local-only
SESSION_SECRET=local-only-change-session-secret-at-least-32-characters
# Stable server-only encryption key shared by API and Worker (at least 32 characters).
# Empty uses SESSION_SECRET for compatibility. Keep the effective key with DB backups;
# changing it requires re-entering saved integration credentials.
INTEGRATION_ENCRYPTION_KEY=
SECURE_COOKIE=false
COOKIE_SAME_SITE=Lax
LOG_LEVEL=info
APP_VERSION=v0.1.0
COMMIT_SHA=development
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=replace_with_random_database_password
REDIS_PASSWORD=replace_with_random_redis_password
IMAGE_REPOSITORY=ghcr.io/amazingz-sys/financial-radar
POLL_INTERVAL_SECONDS=60
# Server environment defaults; console settings override these after first save.
# Keys entered in the console are encrypted in PostgreSQL and never returned to browsers.
# Empty = unavailable, never invented data.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FEISHU_WEBHOOK_URL=
BARK_SERVER_URL=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_DAILY_BUDGET_USD=1
AI_MAX_CALL_COST_USD=0.1
GITHUB_TOKEN=
# Comma-separated manually verified official repositories, max 20. Empty disables GitHub sources.
GITHUB_REPOSITORIES=ordinals/ord
# Known-token watchlist only, never all-chain discovery. Supported chains:
# solana,ethereum,base,arbitrum,optimism,polygon,bsc. Max 30 token addresses on one chain.
# Solana addresses must decode to 32 bytes; EVM chains require 0x + 40 hex characters.
DEX_CHAIN=solana
DEX_TOKEN_ADDRESSES=
UNISAT_API_KEY=
EVM_RPC_URL=
EVM_FACTORY_ADDRESS=
SOLANA_RPC_URL=
SOLANA_PROGRAM_ID=
# Public browser setting only:
VITE_API_BASE_URL=/api/v1
